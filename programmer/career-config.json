  "learning_schedule": {
    "daily_learning_hours": 2,
    "time_slots": {
      "morning": {"time": "08:00-10:00", "focus": ["code-review"], "intensity": "high"},
      "midday": {"time": "10:00-12:00", "focus": ["coding"], "intensity": "high"},
      "afternoon": {"time": "14:00-17:00", "focus": ["testing"], "intensity": "moderate"},
      "evening": {"time": "20:00-22:00", "focus": ["new-tech"], "intensity": "low"}
    }
  },

  "cron_tasks": [
    {
      "name": "daily-memory-backup",
      "schedule": "0 0 * * *",
      "timezone": "Asia/Shanghai",
      "action": "每日24点：回顾会话、提取信息、总结习惯、判断固化技能、生成进化报告",
      "enabled": true
    },
    {
      "name": "weekly-memory-review",
      "schedule": "0 20 * * 0",
      "timezone": "Asia/Shanghai",
      "action": "每周日20点：回顾本周记忆、更新长期记忆、清理过时信息",
      "enabled": true
    },
    {
      "name": "skill-learning",
      "schedule": "0 9,15,21 * * *",
      "timezone": "Asia/Shanghai",
      "action": "按时段学习技能",
      "enabled": true
    }
  ],

  "memory_system": {
    "layers": {
      "L1": {"name": "工作记忆", "storage": "会话临时"},
      "L2": {"name": "短期记忆", "storage": "memory/YYYY-MM-DD.md"},
      "L3": {"name": "长期记忆", "storage": "MEMORY.md"}
    },
    "solidify_rules": {
      "min_usage": 3,
      "must_be_generic": true,
      "must_be_standardizable": true
    }
  },

  "personalization": {
    "tech_stack": ["Python", "TypeScript"],
    "code_style": "google",
    "learning_intensity": "moderate"
  }
}