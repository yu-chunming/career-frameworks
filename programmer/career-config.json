  },

  "skills": [
    {
      "id": "code-review",
      "name": "代码审查",
      "priority": 5,
      "daily_time_minutes": 30,
      "source": "clawhub",
      "install_command": "openclaw skill install code-review"
    },
    {
      "id": "refactor-safely",
      "name": "安全重构",
      "priority": 5,
      "daily_time_minutes": 20,
      "source": "clawhub",
      "install_command": "openclaw skill install refactor-safely"
    },
    {
      "id": "testing-patterns",
      "name": "测试模式",
      "priority": 4,
      "daily_time_minutes": 20,
      "source": "clawhub",
      "install_command": "openclaw skill install testing-patterns"
    },
    {
      "id": "security-audit",
      "name": "安全审计",
      "priority": 4,
      "daily_time_minutes": 15,
      "source": "clawhub",
      "install_command": "openclaw skill install security-audit"
    },
    {
      "id": "python",
      "name": "Python最佳实践",
      "priority": 4,
      "daily_time_minutes": 15,
      "source": "clawhub",
      "install_command": "openclaw skill install python"
    },
